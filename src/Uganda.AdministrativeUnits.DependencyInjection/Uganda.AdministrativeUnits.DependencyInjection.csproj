<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Microsoft.Extensions.DependencyInjection</RootNamespace>
    <AssemblyName>Uganda.AdministrativeUnits.DependencyInjection</AssemblyName>

    <PackageId>Uganda.AdministrativeUnits.DependencyInjection</PackageId>
    <Version>1.0.0</Version>
    <Description>Microsoft.Extensions.DependencyInjection registration for Uganda.AdministrativeUnits.</Description>
    <PackageTags>uganda;administrative-units;dependency-injection;aspnetcore</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <ProjectReference Include="..\Uganda.AdministrativeUnits\Uganda.AdministrativeUnits.csproj" />
  </ItemGroup>

</Project>
