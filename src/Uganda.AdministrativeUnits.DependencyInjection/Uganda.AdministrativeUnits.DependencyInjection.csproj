<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <RootNamespace>Microsoft.Extensions.DependencyInjection</RootNamespace>
    <AssemblyName>Uganda.AdministrativeUnits.DependencyInjection</AssemblyName>

    <PackageId>Uganda.AdministrativeUnits.DependencyInjection</PackageId>
    <Version>1.1.0</Version>
    <Description>Microsoft.Extensions.DependencyInjection registration for Uganda.AdministrativeUnits. Supports .NET Framework 4.6.1+ (via netstandard2.0) and .NET 8+.</Description>
    <PackageTags>uganda;administrative-units;dependency-injection;aspnetcore;netframework</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>1.1.0: Multi-target netstandard2.0 and net8.0 for .NET Framework 4.6.1+ support.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <ProjectReference Include="..\Uganda.AdministrativeUnits\Uganda.AdministrativeUnits.csproj" />
  </ItemGroup>

</Project>
