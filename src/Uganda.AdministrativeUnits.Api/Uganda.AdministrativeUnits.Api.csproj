<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Uganda.AdministrativeUnits.Api</RootNamespace>
    <AssemblyName>Uganda.AdministrativeUnits.Api</AssemblyName>
    <Description>Production Web API for Uganda administrative units with Scalar documentation.</Description>
    <UserSecretsId>uganda-administrative-units-api</UserSecretsId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.12.17" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Uganda.AdministrativeUnits.Application\Uganda.AdministrativeUnits.Application.csproj" />
    <ProjectReference Include="..\Uganda.AdministrativeUnits.Infrastructure\Uganda.AdministrativeUnits.Infrastructure.csproj" />
  </ItemGroup>

</Project>
