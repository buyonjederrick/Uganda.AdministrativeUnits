<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Uganda.AdministrativeUnits</RootNamespace>
    <AssemblyName>Uganda.AdministrativeUnits</AssemblyName>

    <!-- Package metadata -->
    <PackageId>Uganda.AdministrativeUnits</PackageId>
    <Version>1.0.0</Version>
    <Description>Offline, dependency-free directory of Uganda's verified administrative units (July 2022): 146 districts, constituencies, subcounties/town councils, parishes and 71,230 villages, with codes, hierarchy navigation and name search.</Description>
    <PackageTags>uganda;administrative-units;districts;subcounties;parishes;villages;geography;gazetteer;address</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- Set Authors, Company and RepositoryUrl before publishing. -->

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\uganda-administrative-units-2022-07.json.gz"
                      LogicalName="Uganda.AdministrativeUnits.Data.uganda-administrative-units-2022-07.json.gz" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
